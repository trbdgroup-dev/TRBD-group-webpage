# Copy to .env and fill in. Never commit .env.

# Postgres (local Supabase: `npx supabase start`, then use the DB URL it prints)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=

# Public base URL of the site (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret on admin preview links (at least 16 random characters)
PREVIEW_SECRET=

# Local seeding only (npm run seed:admin). Use a throwaway password; never a real one.
SEED_ADMIN_EMAIL=admin@trbdgroup.test
SEED_ADMIN_PASSWORD=

# Media storage. `s3` = Supabase Storage (S3 protocol); `local` = ./media on disk (CI, tests).
# Local Supabase values come from `npx supabase status -o env` (S3_PROTOCOL_* and API_URL).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=media
S3_PUBLIC_URL=http://127.0.0.1:54321/storage/v1/object/public/media
