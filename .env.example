# Copy to .env and fill in. Never commit .env.

# Postgres (local Supabase: `npx supabase start`, then use the DB URL it prints)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=

# Public base URL of the site (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
